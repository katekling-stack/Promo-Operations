# Copy to .env and fill in. Never commit .env.
# Every integration client reads its credentials from these variables.

# --- FreeWheel (shmcp.freewheel.com / MRM API) ---
# Auth is username/password (API user of the form AdOps.api@<network_id>).
# Test network is 520310; production is 520311.
FREEWHEEL_BASE_URL=https://api.freewheel.tv
FREEWHEEL_NETWORK_ID=520310
FREEWHEEL_USERNAME=
FREEWHEEL_PASSWORD=
# Advertisers we operate under are matched by this name fragment:
FREEWHEEL_ADVERTISER_NAME_FILTER=VCBS

# --- Salesforce (Case = source of truth for campaign inputs) ---
SALESFORCE_INSTANCE_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=

# --- Google Ad Manager ---
GAM_NETWORK_CODE=
GAM_SERVICE_ACCOUNT_JSON=service-account.json
GAM_APPLICATION_NAME=paramount-promo-ops

# --- Operative (Operative One) ---
OPERATIVE_BASE_URL=
OPERATIVE_API_KEY=

# --- Google Drive (for reading the Audience Segments sheet / plan templates) ---
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=service-account.json
AUDIENCE_SEGMENTS_SHEET_ID=1D5JpDCqmNclIXlVj8BjHSS9a4t4tTYy55u57GD9UkbE
