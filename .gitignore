# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/

# Secrets & credentials — never commit
.env
*.pem
*.json.key
service-account*.json
gam.yaml
googleads.yaml

# Local build output
/build/
/out/

# Live syncs are regenerated; only seed_*.csv is committed — EXCEPT the two snapshots the
# shipped form's pickers depend on (series name->ID and DDA audience item IDs), which are
# committed so a fresh download resolves everything the form offers without a sync step.
# Refresh them anytime with `promo-ops sync-all` (or sync-series / sync-audience-items).
data/audience_segments/synced_*.csv
!data/audience_segments/synced_audience_items.csv
data/standard_attributes/synced_*.csv
data/geo/synced_*.csv
data/ad_units/synced_*.csv
data/site_groups/synced_*.csv
data/series/synced_*.csv
!data/series/synced_series.csv
data/video_groups/synced_*.csv
# committed: the rating-restriction picker + resolver depend on this snapshot
!data/video_groups/synced_content_rating_video_groups.csv
# committed: the sub-genre picker + resolver depend on this snapshot
!data/video_groups/synced_genre_sub_video_groups.csv
# committed: the daypart picker + resolver depend on this snapshot
!data/video_groups/synced_daypart_video_groups.csv
# committed: the Brand (Biz Div-Brand) picker + resolver depend on this snapshot
!data/video_groups/synced_brand_video_groups.csv
